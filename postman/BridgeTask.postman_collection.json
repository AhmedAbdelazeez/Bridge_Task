{
  "info": {
    "name": "BridgeTask API",
    "description": "Countries and Cities API. Run the whole collection in order (Collection Runner or newman): requests pass ids to each other through collection variables, and the Cleanup folder removes the created data. Country codes are random per run so the collection can be repeated against the same database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "  pm.test('Error response is ProblemDetails', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "    const body = pm.response.json();",
          "    pm.expect(body.status).to.eql(pm.response.code);",
          "    pm.expect(body).to.have.property('type');",
          "    pm.expect(body).to.have.property('title');",
          "    pm.expect(body).to.have.property('traceId');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Countries",
      "item": [
        {
          "name": "Create Country",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/countries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "countries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{countryName}}\",\n  \"code\": \"{{countryCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const letters = () => Array.from({ length: 3 }, () => String.fromCharCode(65 + Math.floor(Math.random() * 26))).join('');",
                  "const code = letters();",
                  "pm.collectionVariables.set('countryCode', code);",
                  "pm.collectionVariables.set('countryName', 'Egypt ' + code);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created country', () => {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.name).to.eql(pm.collectionVariables.get('countryName'));",
                  "  pm.expect(body.code).to.eql(pm.collectionVariables.get('countryCode'));",
                  "});",
                  "pm.test('Location header points to the new country', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/api/countries/' + body.id);",
                  "});",
                  "pm.collectionVariables.set('countryId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Country",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/countries/{{countryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "countries",
                "{{countryId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the requested country', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('countryId')));",
                  "  pm.expect(body).to.have.all.keys('id', 'name', 'code');",
                  "});"
                ]
              }
            }
          ]
        },
